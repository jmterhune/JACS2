IF EXISTS (SELECT * FROM sys.objects WHERE [object_id] = OBJECT_ID(N'{databaseOwner}[tjc_prose_history_list]') AND type in (N'V'))
	DROP VIEW {databaseOwner}[tjc_prose_history_list]
GO
CREATE VIEW {databaseOwner}[tjc_prose_history_list]
AS
SELECT        {databaseOwner}Users.DisplayName AS LastModifiedByName, {databaseOwner}tjc_prose_history.*, {databaseOwner}tjc_prose_contact.ContactName, {databaseOwner}tjc_gl_counties.CountyName, {databaseOwner}tjc_prose_case_type.CaseTypeName
FROM            {databaseOwner}Users RIGHT OUTER JOIN
                         {databaseOwner}tjc_prose_history ON {databaseOwner}Users.UserID = {databaseOwner}tjc_prose_history.LastModifiedByID LEFT OUTER JOIN
                         {databaseOwner}tjc_prose_contact ON {databaseOwner}tjc_prose_history.ContactID = {databaseOwner}tjc_prose_contact.ContactID LEFT OUTER JOIN
                         {databaseOwner}tjc_prose_case_type ON {databaseOwner}tjc_prose_history.CaseTypeID = {databaseOwner}tjc_prose_case_type.CaseTypeID LEFT OUTER JOIN
                         {databaseOwner}tjc_gl_counties ON {databaseOwner}tjc_prose_history.CountyID = {databaseOwner}tjc_gl_counties.CountyId
GO

                    <viewOrder>0</viewOrder>
                  </moduleControl>
                  <moduleControl>
                    <controlKey>EditCalendarGrid</controlKey>
                    <controlSrc>DesktopModules/tjc.modules/CourtCalendar/Views/EditCalendarGrid.ascx</controlSrc>

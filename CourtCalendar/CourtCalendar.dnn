                    <viewOrder>0</viewOrder>
                  </moduleControl>
                  <moduleControl>
                    <controlKey>ManageDivisions</controlKey>
                    <controlSrc>DesktopModules/tjc.modules/CourtCalendar/Views/ManageDivisions.ascx</controlSrc>

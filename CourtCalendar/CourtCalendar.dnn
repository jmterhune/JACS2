<dotnetnuke type="Package" version="5.0">
  <packages>
    <package name="CourtCalendarAdmin" type="Module" version="00.00.01">
      <friendlyName>Court Calendar Authoring</friendlyName>
      <description>Intranet authoring for the public Court Calendar. Admins manage judges, divisions and categories; assigned judges and JAs manage their division's monthly calendars (week headers, entries, strikes) and notify subscribers. Reads and writes the public site's tjc_cc_* tables through the Jud12 connection.</description>
      <iconFile>~/Icons/Sigma/Calendar_32X32_Standard.png</iconFile>
      <owner>
        <name>12th Judicial Circuit</name>
        <organization>12th Judicial Circuit</organization>
        <url>https://www.jud12.flcourts.org/</url>
        <email>jterhune@jud12.flcourts.org</email>
      </owner>
      <license src="License.txt"></license>
      <releaseNotes src="ReleaseNotes.txt"></releaseNotes>
      <azureCompatible>true</azureCompatible>
      <dependencies>
        <dependency type="CoreVersion">09.08.00</dependency>
      </dependencies>
      <components>
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/tjc.modules/CourtCalendar</basePath>
            <resourceFile>
              <name>Resources.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>
        <component type="Module">
          <desktopModule>
            <moduleName>CourtCalendarAdmin</moduleName>
            <foldername>tjc.modules/CourtCalendar</foldername>
            <businessControllerClass />
            <supportedFeatures />
            <moduleDefinitions>
              <moduleDefinition>
                <friendlyName>Court Calendar Authoring</friendlyName>
                <definitionName>CourtCalendarAdmin</definitionName>
                <defaultCacheTime>0</defaultCacheTime>
                <moduleControls>
                  <moduleControl>
                    <controlKey />

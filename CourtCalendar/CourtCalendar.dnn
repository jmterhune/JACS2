                    <supportsPartialRendering>False</supportsPartialRendering>
                    <controlTitle>Manage Categories</controlTitle>
                    <controlType>View</controlType>
                    <iconFile />
                    <helpUrl />
                    <viewOrder>0</viewOrder>
                  </moduleControl>
                  <moduleControl>
                    <controlKey>EditCalendar</controlKey>
                    <controlSrc>DesktopModules/tjc.modules/CourtCalendar/Views/EditCalendar.ascx</controlSrc>

/***********************************************************************
 * EmployeeDB 0.0.1 install script
 *
 * All tjc_employee_* and tjc_gl_* tables already exist in the database
 * before this module is installed; nothing to create here.
 *
 * The legacy tjc_employee_assigned_item table created in earlier dev
 * builds was rejected and is dropped explicitly so the schema doesn't
 * carry the abandoned column set forward.
 ***********************************************************************/

IF EXISTS (SELECT 1 FROM sys.tables WHERE name = '{objectQualifier}tjc_employee_assigned_item')
BEGIN
    DROP TABLE {databaseOwner}{objectQualifier}tjc_employee_assigned_item
END
GO

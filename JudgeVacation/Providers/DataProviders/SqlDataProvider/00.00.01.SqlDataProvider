/****** Object:  StoredProcedure [dbo].[tjc_vacation_get_judge_years]    Script Date: 8/14/2024 2:57:40 PM ******/
IF EXISTS (SELECT * FROM sys.objects WHERE [object_id] = OBJECT_ID(N'{databaseOwner}[tjc_vacation_get_judge_years]') AND type in (N'P'))
	DROP PROCEDURE {databaseOwner}[tjc_vacation_get_judge_years]
GO

CREATE PROCEDURE {databaseOwner}[tjc_vacation_get_judge_years] 
	@judgeId int
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	SELECT YEAR(endDate) as Years from tjc_vacation_vacations
	Where JudgeId=@judgeId
	Group By YEAR(endDate)
	Order by 1
END

GO
/****** Object:  StoredProcedure [dbo].[tjc_vacation_judge_report]    Script Date: 8/14/2024 2:57:40 PM ******/
IF EXISTS (SELECT * FROM sys.objects WHERE [object_id] = OBJECT_ID(N'{databaseOwner}[tjc_vacation_judge_report]') AND type in (N'P'))
	DROP PROCEDURE {databaseOwner}[tjc_vacation_judge_report]
GO
CREATE PROCEDURE {databaseOwner}[tjc_vacation_judge_report]
	@startDate datetime,@enddate datetime
AS
BEGIN
	
	SET NOCOUNT ON;

		SELECT v.*,u.DisplayName as JudgeName, vacationdays,g.subtotal 
	from tjc_vacation_vacations v 
		inner join users u on v.JudgeId=u.UserID 
		Inner join (select judgeId,sum(VacationDays) as subtotal 
			from tjc_vacation_vacations 
				Where (StartDate Between @startDate and @enddate) OR (EndDate Between @startDate and @enddate)
				group by judgeId) g on g.JudgeId=v.JudgeId

	Where (StartDate Between @startDate and @enddate) OR (EndDate Between @startDate and @enddate)
	order by JudgeName,enddate
END
GO
/****** Object:  StoredProcedure [dbo].[tjc_vacation_report_by_judge]    Script Date: 8/14/2024 2:57:40 PM ******/
IF EXISTS (SELECT * FROM sys.objects WHERE [object_id] = OBJECT_ID(N'{databaseOwner}[tjc_vacation_report_by_judge]') AND type in (N'P'))
	DROP PROCEDURE {databaseOwner}[tjc_vacation_report_by_judge]
GO

CREATE PROCEDURE {databaseOwner}[tjc_vacation_report_by_judge] 
	@startDate datetime,@enddate datetime,@judgeId int
AS
BEGIN
	
	SET NOCOUNT ON;

	SELECT v.*,u.DisplayName as JudgeName from tjc_vacation_vacations v inner join users u on v.JudgeId=u.UserID
	Where ((StartDate >= @startDate and StartDate <= @enddate) OR (EndDate>= @startDate and EndDate <= @enddate)) And v.JudgeId=@judgeId
END


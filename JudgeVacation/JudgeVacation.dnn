<dotnetnuke type="Package" version="5.0">
  <packages>
    <package name="JudgeVacation" type="Module" version="00.00.01">
      <friendlyName>Judge Vacation Tracker</friendlyName>
      <description>Judge Vacation Tracker</description>
      <iconFile>~/Icons/Sigma/Extensions_32x32_Standard.png</iconFile>
      <owner>
        <name>Joe Terhune</name>
        <organization>Joe Terhune</organization>
        <url>https://www.jud12.flcourts.org/</url>
        <email>jterhune@jud12.flcourts.org</email>
      </owner>
      <license src="License.txt"></license>
      <releaseNotes src="ReleaseNotes.txt"></releaseNotes>
      <azureCompatible>true</azureCompatible>
      <dependencies>
        <dependency type="CoreVersion">09.08.00</dependency>
      </dependencies>
      <components>
        <component type="Script">
          <scripts>
            <basePath>DesktopModules\tjc.Modules\JudgeVacation</basePath>
            <script type="Install">
              <path>Providers\DataProviders\SqlDataProvider</path>
              <name>00.00.01.SqlDataProvider</name>
              <version>00.00.01</version>
            </script>
            <script type="UnInstall">
              <path>Providers\DataProviders\SqlDataProvider</path>
              <name>Uninstall.SqlDataProvider</name>
              <version>00.00.01</version>
            </script>
          </scripts>
        </component>
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/tjc.Modules/JudgeVacation</basePath>
            <resourceFile>
              <name>Resources.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>
        <component type="Module">
          <desktopModule>
            <moduleName>Judge Vacation Tracker</moduleName>
            <foldername>JudgeVacation</foldername>
            <businessControllerClass />
            <supportedFeatures />
            <moduleDefinitions>
              <moduleDefinition>
                <friendlyName>JudgeVacation</friendlyName>
                <defaultCacheTime>0</defaultCacheTime>
				  <moduleControls>
					  <moduleControl>
						  <controlKey />
						  <controlSrc>DesktopModules/tjc.Modules/JudgeVacation/View.ascx</controlSrc>
						  <supportsPartialRendering>False</supportsPartialRendering>
						  <controlTitle />
						  <controlType>View</controlType>
						  <iconFile />
						  <helpUrl />
						  <supportsPopUps>False</supportsPopUps>
						  <viewOrder>0</viewOrder>
					  </moduleControl>
					  <moduleControl>
						  <controlKey>holiday</controlKey>
						  <controlSrc>DesktopModules/tjc.Modules/JudgeVacation/Holidays.ascx</controlSrc>
						  <supportsPartialRendering>False</supportsPartialRendering>
						  <controlTitle>Manage Holidays</controlTitle>
						  <controlType>Admin</controlType>
						  <iconFile />
						  <helpUrl />
						  <supportsPopUps>False</supportsPopUps>
					  </moduleControl>
					  <moduleControl>
						  <controlKey>reports</controlKey>
						  <controlSrc>DesktopModules/tjc.Modules/JudgeVacation/Reports.ascx</controlSrc>
						  <supportsPartialRendering>False</supportsPartialRendering>
						  <controlTitle>Reports</controlTitle>
						  <controlType>View</controlType>
						  <iconFile />
						  <helpUrl />
						  <supportsPopUps>False</supportsPopUps>
					  </moduleControl>
					  <moduleControl>
						  <controlKey>Settings</controlKey>
						  <controlSrc>DesktopModules/tjc.Modules/JudgeVacation/Settings.ascx</controlSrc>
						  <supportsPartialRendering>False</supportsPartialRendering>
						  <controlTitle>Judge Vacation Settings</controlTitle>
						  <controlType>Edit</controlType>
						  <iconFile />
						  <helpUrl />
						  <supportsPopUps>False</supportsPopUps>
					  </moduleControl>
				  </moduleControls>
			  </moduleDefinition>
            </moduleDefinitions>
          </desktopModule>
        </component>
        <component type="Assembly">
          <assemblies>
            <assembly>
              <name>tjc.Modules.JudgeVacation.dll</name>
              <path>bin</path>
            </assembly>
          </assemblies>
        </component>
      </components>
    </package>
  </packages>
</dotnetnuke>
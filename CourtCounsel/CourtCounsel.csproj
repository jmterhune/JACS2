  <Import Project="BuildScripts\ModulePackage.Targets" />
  <Target Name="AfterBuild" DependsOnTargets="PackageModule;DeployToSite">
  </Target>
  <Target Name="DeployToSite" Condition="'$(DeployToSite)' == 'true' And Exists('$(DeploySitePath)\bin')">
    <Message Text="Deploying CourtCounsel to $(DeploySitePath)" Importance="high" />
    <!-- Copy assembly to site bin -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(DeploySitePath)\bin" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(DeploySitePath)\bin" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    <!-- Copy web content to DesktopModules -->
    <ItemGroup>
      <DeployContent Include="Views\**\*.ascx" />
      <DeployContent Include="App_LocalResources\**\*.resx" />
      <DeployContent Include="Styles\**\*.css" />
      <DeployContent Include="Scripts\**\*.js" />
      <DeployContent Include="$(DNNFileName).dnn" />
      <DeployContent Include="License.txt" />
      <DeployContent Include="ReleaseNotes.txt" />
      <DeployContent Include="Providers\DataProviders\SqlDataProvider\*.SqlDataProvider" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployContent)" DestinationFiles="@(DeployContent->'$(DeployModuleFolder)\%(RelativeDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- Fire-and-forget ping so IIS picks up the new DLL. Runs in a detached hidden powershell; MSBuild returns immediately. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\BuildScripts\PingDevSite.ps1&quot; -Url &quot;$(DevSiteUrl)&quot;"
          IgnoreExitCode="true"
          ContinueOnError="true"
          Condition="Exists('$(MSBuildProjectDirectory)\BuildScripts\PingDevSite.ps1')" />
  </Target>

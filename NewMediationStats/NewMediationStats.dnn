<dotnetnuke type="Package" version="5.0">
  <packages>
    <package name="NewMediationStats" type="Module" version="00.00.01">
      <friendlyName>New Mediation Statistics</friendlyName>
      <description>12th Judicial Circuit mediation statistics, rebuilt from the Mediation Statistics module for the revised s. 44.108, F.S. fee and income tiers. Uses its own tjc_modules_med_ tables so it runs alongside the original module without sharing any data.</description>
      <iconFile>~/Icons/Sigma/Source_32X32_Standard.png</iconFile>
      <owner>
        <name>12th Judicial Circuit</name>
        <organization>12th Judicial Circuit</organization>
        <url>https://www.jud12.flcourts.org</url>
        <email>jterhune@jud12.flcourts.org</email>
      </owner>
      <license src="License.txt"></license>
      <releaseNotes src="ReleaseNotes.txt"></releaseNotes>
      <azureCompatible>true</azureCompatible>
      <dependencies>
        <dependency type="CoreVersion">09.08.00</dependency>
      </dependencies>

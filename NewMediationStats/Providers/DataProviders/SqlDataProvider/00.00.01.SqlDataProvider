CREATE OR ALTER VIEW dbo.tjc_modules_med_case_list
AS
SELECT        dbo.tjc_modules_med_get_case_cdsp_number(ISNULL(c.CaseNumber, N''), ISNULL(c.CDSPNumber, N'')) AS ListNumber, r.Description AS Region, g.Description AS [Group], ISNULL(c.p1_FirstName + ' ', '') + ISNULL(c.p1_LastName, '') 
                         + ISNULL(c.p1_business, '') AS PartyOne, ISNULL(c.p2_FirstName + ' ', '') + ISNULL(c.p2_LastName, '') + ISNULL(c.p2_business, '') AS PartyTwo, c.CreatedDate, c.CaseId, c.p1_FirstName, c.p1_LastName, c.p1_business, 
                         c.p2_FirstName, c.p2_LastName, c.p2_business, c.RegionId, c.GroupId, c.CreatedById, c.LastModifiedDate, c.LastModifiedById, c.CaseNumber, c.CDSPNumber, dbo.tjc_modules_med_consolidate_session_comments(c.CaseId) 
                         AS Comment
FROM            dbo.tjc_modules_med_cases AS c INNER JOIN
                         dbo.tjc_modules_med_regions AS r ON c.RegionId = r.RegionId INNER JOIN
                         dbo.tjc_modules_med_groups AS g ON c.GroupId = g.GroupId
GO

CREATE OR ALTER VIEW dbo.tjc_modules_med_session_counts
AS
SELECT        dbo.tjc_modules_med_regions.Description AS Region, dbo.tjc_modules_med_casetypes.Description AS CaseType, dbo.tjc_modules_med_groups.Description AS CaseTypeGroup, dbo.tjc_modules_med_stage_action.Description AS StageOfAction, 
                         dbo.tjc_modules_med_sessions.MediationDate, dbo.tjc_modules_med_sessions.Mediator, dbo.tjc_modules_med_sessions.ReferralDate, dbo.tjc_modules_med_sessions.ArbitrationReferral, dbo.tjc_modules_med_sessions.CircuitCivilReferral, 
                         dbo.tjc_modules_med_sessions.FeeAmount, dbo.tjc_modules_med_sessions.HeldByPhone, dbo.tjc_modules_med_sessions.PTC_CourtOrdered, dbo.tjc_modules_med_sessions.CreatedDate, dbo.tjc_modules_med_session_held(dbo.tjc_modules_med_sessions.SessionId) 
                         AS MediationHeld, dbo.tjc_modules_med_sessions.SessionId, dbo.tjc_modules_med_agreement_reached(dbo.tjc_modules_med_sessions.SessionId) AS AgreementReached, dbo.tjc_modules_med_get_case_cdsp_number(dbo.tjc_modules_med_cases.CaseNumber, 
                         dbo.tjc_modules_med_cases.CDSPNumber) AS CaseNumber, dbo.tjc_modules_med_get_party_name(dbo.tjc_modules_med_cases.p1_FirstName, dbo.tjc_modules_med_cases.p1_LastName, dbo.tjc_modules_med_cases.p1_business) AS partyone, 
                         dbo.tjc_modules_med_get_party_name(dbo.tjc_modules_med_cases.p2_FirstName, dbo.tjc_modules_med_cases.p2_LastName, dbo.tjc_modules_med_cases.p2_business) AS partytwo, dbo.tjc_modules_med_sessions.FeeJudgement, dbo.tjc_modules_med_sessions.FeeAgreement, 
                         dbo.tjc_modules_med_sessions.p1_FTA, dbo.tjc_modules_med_sessions.p2_FTA, dbo.tjc_modules_med_sessions.OTS, dbo.tjc_modules_med_sessions.FeeWaiver, dbo.tjc_modules_med_sessions.ChildrenInvolved, dbo.tjc_modules_med_sessions.ParentsInvolved, 
                         dbo.tjc_modules_med_sessions.Inmate, dbo.tjc_modules_med_sessions.Interpreter

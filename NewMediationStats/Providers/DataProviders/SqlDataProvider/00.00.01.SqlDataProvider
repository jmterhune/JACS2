/***** Functions *****/

CREATE OR ALTER FUNCTION [dbo].[tjc_modules_med_agreement_reached]
(
	@sessionID int
)
RETURNS bit
AS
BEGIN
	DECLARE @reached bit

	IF EXISTS(Select eventId from tjc_modules_med_events where sessionId=@sessionId and agreementType<>'N' AND AgreementType is not null)
		BEGIN
		SET @reached=1
		END
	ELSE
		BEGIN
		SET @reached=0
		END

	RETURN @reached

END
GO

-- =============================================
-- Author:		<Joe Terhune>
-- Create date: <6/21/2024>
-- Description:	<Combines all session comments per case>
-- =============================================
CREATE OR ALTER FUNCTION [dbo].[tjc_modules_med_consolidate_session_comments]
(
	@caseId int
)
RETURNS nvarchar(MAX)
AS
BEGIN
	-- Declare the return variable here
	DECLARE @comments nvarchar(MAX)

set @comments = ''

select @comments = 
	Case When @comments = ''
		Then Comment
		Else @comments + + coalesce('|' + Comment, '')
	End   
  from  tjc_modules_med_sessions
  Where CaseId=@caseId and RTRIM(ISNULL(comment,''))<>''


	-- Return the result of the function
	RETURN @comments

END
GO

-- =============================================
-- Author:		<Joe Terhune>
-- Create date: <1/27/2025>
-- Description:	<Gets the case / cdsp number>
-- =============================================
CREATE OR ALTER FUNCTION [dbo].[tjc_modules_med_get_case_cdsp_number] 
(
	@case nvarchar(20),@cdsp nvarchar(20)
)
RETURNS nvarchar(50)
AS
BEGIN
	DECLARE @listNumber nvarchar(50)
	IF @case <> '' AND @cdsp <> ''
		BEGIN
			Set @listNumber= @case + ' | ' + @cdsp
		END
	ELSE IF @case <> ''
		BEGIN
			Set @listNumber= @case
		END
	ELSE
		BEGIN
		Set @listNumber= @cdsp
		END

	RETURN @listNumber
END
GO

-- =============================================
-- Author:		<Joe Terhune>
-- Create date: <7/14/2023>
-- Description:	<Get Mediation Party Name>
-- =============================================
CREATE OR ALTER FUNCTION [dbo].[tjc_modules_med_get_party_name] 
(
	-- Add the parameters for the function here
	@partyFirst nvarchar(50),@partyLast nvarchar(50),@business nvarchar(50)
)
RETURNS nvarchar(150)
AS
BEGIN
	DECLARE @result nvarchar(150);
	DECLARE @lenFirst int = LEN(@partyFirst);
	DECLARE	@lenLast int = LEN(@partyLast);

	IF @lenFirst + @lenLast > 0
		BEGIN
			IF @lenFirst > 0 AND @lenLast > 0
				BEGIN
					SELECT @result = @partylast + ', ' + @partyFirst;
				END
			ELSE IF @lenFirst>0
				BEGIN
					SELECT @result = @partyFirst;
				END
			ELSE
				BEGIN
					SELECT @result = @partylast;
				END
		END
	ELSE
		BEGIN
			SELECT @result =@business;
		END

	RETURN @result

END
GO

-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date, ,>
-- Description:	<Description, ,>
-- =============================================
CREATE OR ALTER FUNCTION [dbo].[tjc_modules_med_get_partyname]
(
	@firstname nvarchar(50),@lastname nvarchar(50),@business nvarchar(50)
)
RETURNS nvarchar(150)
AS
BEGIN
	-- Declare the return variable here
	DECLARE @partyName nvarchar(150)
	
	IF @firstname IS NULL SET @firstname = ''
	IF @lastName IS NULL SET @lastname = ''
	IF @business IS NULL SET @business = ''

	IF @firstname <> '' AND @lastname <> ''
		BEGIN
			SET	@partyName=@lastname + ', ' + @firstname
		END
	ELSE
		BEGIN
			IF @business <> ''
				SET @partyName = @business
			ELSE
				SET @partyName = @firstname + @lastname
		END

	-- Return the result of the function
	RETURN @partyName

END
GO

CREATE OR ALTER FUNCTION [dbo].[tjc_modules_med_session_held]
(
	@sessionID int
)
RETURNS bit
AS
BEGIN
	DECLARE @held bit

	IF EXISTS(Select eventId from tjc_modules_med_events where sessionId=@sessionId and mediationHeld=1)
		BEGIN
		SET @held=1
		END
	ELSE
		BEGIN
		SET @held=0
		END

	RETURN @held

END
GO


CREATE OR ALTER PROCEDURE [dbo].[tjc_modules_med_get_case_list] 
	@groupId int,@regionId int,@caseNumber nvarchar(50),@cdspNumber nvarchar(50),@firstName nvarchar(50),@lastName nvarchar(50),@startDate datetime,@endDate datetime
AS

BEGIN
	DECLARE @sql nvarchar(MAX)='SELECT c.*, r.Description as ''Region'',g.Description as ''Group'' from tjc_modules_med_cases c inner join tjc_modules_med_regions r on c.RegionId=r.RegionId inner join tjc_modules_med_groups g on c.GroupId=g.GroupId Where (c.CreatedDate Between @startDate AND @endDate)';
	DECLARE @ParameterDef nvarchar(MAX)
 
    SET @ParameterDef = '@groupId int, @regionId int, @caseNumber nvarchar(50),@cdspNumber nvarchar(50),@firstName nvarchar(50),@lastName nvarchar(50),@startDate datetime,@endDate datetime';
							
	SET NOCOUNT ON;
	IF @groupId>0
		BEGIN
			SET	@sql = @sql + ' And g.GroupId =  @groupId';
		END
	IF @regionId>0
		BEGIN
			SET	@sql = @sql + ' And r.RegionId =  @regionId';
		END
	IF LEN(@caseNumber) > 0
		BEGIN
			SET	@sql = @sql +' And CaseNumber like @caseNumber +''%''';
		END
	IF LEN(@cdspNumber) > 0
		BEGIN
			SET	@sql = @sql +' And CDSPNumber like @cdspNumber +''%''';
		END
	IF LEN(@firstName) > 0
		BEGIN
			SET	@sql = @sql +' And (p1_FirstName like @firstName + ''%'' OR p2_FirstName like @firstName + ''%'')';
		END
	IF LEN(@lastName) > 0
		BEGIN
			SET	@sql = @sql +' And (p1_LastName like @lastName + ''%'' OR p2_LastName like @lastName + ''%'')';
		END
		SET	@sql = @sql + ' Order by c.CreatedDate DESC';
    -- Execute parameratized SQL
	EXEC sp_Executesql  @sql,  @ParameterDef, @groupId=@groupId,@regionId=@regionId,@caseNumber=@caseNumber,@cdspNumber=@cdspNumber,@firstName=@firstName,@lastName=@lastName,@startDate=@startDate,@endDate=@endDate;
 
	
END
GO


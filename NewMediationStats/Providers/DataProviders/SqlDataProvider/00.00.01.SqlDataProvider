CREATE OR ALTER PROCEDURE [dbo].[tjc_modules_med_fee_report_collected_owed] 
@startDate datetime,@endDate datetime

AS
BEGIN
	
	SET NOCOUNT ON;
	DECLARE @mediationCounty int, @mediationFamily int,@p1CountyPaid60 int,@p1CountyOwed60 int,
		@p1familyOwed60 int,@p1familyOwed120 int,@p1familyPaid60 int,@p1familyPaid120 int,
		@p2CountyPaid60 int,@p2CountyOwed60 int,@p2CountyOwedFTA60 int,@p1CountyOwedFTA60 int,
		@p2familyOwed60 int,@p2familyOwed120 int,@p2familyPaid60 int,@p2familyPaid120 int,
		@p2familyOwedFTA120 int,@p2familyOwedFTA60 int,@p1familyOwedFTA120 int,@p1familyOwedFTA60 int,
		@p1familyPaidIndigent int,@p2familyPaidIndigent int,@p1CountyPaidIndigent int,@p2CountyPaidIndigent int,
		@p1familyOwedIndigent int,@p2familyOwedIndigent int,@p1CountyOwedIndigent int,@p2CountyOwedIndigent int,
		@p1familyOwedIndigentFTA int,@p2familyOwedIndigentFTA int,@p1CountyOwedIndigentFTA int,@p2CountyOwedIndigentFTA int,
		@CountyPaidWaived int,@CountyOwedWaived int,@CountyOwedWaivedFTA int,
		@FamilyPaidWaived int,@FamilyOwedWaived int,@FamilyOwedWaivedFTA int
	
	--Count of Meidations
	SELECT @mediationCounty = COUNT(sessionId) from tjc_modules_med_fee_report_collected 
	WHERE  CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate) AND sessionId IN (Select SessionId from tjc_modules_med_events Where MediationHeld=1)
	
	SELECT @mediationFamily = COUNT(sessionId) from tjc_modules_med_fee_report_collected 
	WHERE  CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate) AND sessionId IN (Select SessionId from tjc_modules_med_events Where MediationHeld=1)
	
	--County Paid
	SELECT @p1CountyPaid60 = COUNT(p1_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE p1_feespaid='$60' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2CountyPaid60 = COUNT(p2_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE p2_feespaid='$60' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p1CountyPaidIndigent = COUNT(p1_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE p1_feespaid='Indigent' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p2CountyPaidIndigent = COUNT(p2_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE p2_feespaid='Indigent' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @CountyPaidWaived = COUNT(sessionid) from tjc_modules_med_fee_report_collected 
	WHERE FeeWaiver=1 AND CaseTypeGroupId=2 AND (p1_FeesPaid IN ('$60','Indigent') OR p2_FeesPaid IN ('$60','Indigent')) AND (MediationDate Between @startDate AND @endDate)
				

	--Family Paid
	SELECT @p1FamilyPaid60 = COUNT(p1_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE  p1_feespaid='$60' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2FamilyPaid60 = COUNT(p2_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE p2_feespaid='$60' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p1FamilyPaid120 = COUNT(p1_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE p1_feespaid='$120' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2FamilyPaid120 = COUNT(p2_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE p2_feespaid='$120' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p1familyPaidIndigent = COUNT(p1_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE p1_feespaid='Indigent' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p2familyPaidIndigent = COUNT(p2_feespaid) from tjc_modules_med_fee_report_collected 
	WHERE p2_feespaid='Indigent' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)

	SELECT @FamilyPaidWaived = COUNT(sessionid) from tjc_modules_med_fee_report_collected 
	WHERE FeeWaiver=1 AND CaseTypeGroupId=4 AND (p1_FeesPaid IN ('$60','Indigent','$120') OR p2_FeesPaid IN ('$60','Indigent','$120')) AND (MediationDate Between @startDate AND @endDate)

		--County Owed
	SELECT @p1CountyOwed60 = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p1_feesOwed='$60' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2CountyOwed60 = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p2_feesOwed='$60' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p1CountyOwedIndigent = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p1_feesOwed='Certificate of Indigency' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2CountyOwedIndigent = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p2_feesOwed='Certificate of Indigency' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)

	SELECT @CountyOwedWaived = COUNT(sessionid) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND FeeWaiver=1 AND CaseTypeGroupId=2 AND (p1_feesOwed IN ('$60','Certificate of Indigency') OR p2_feesOwed IN ('$60','Certificate of Indigency')) AND (MediationDate Between @startDate AND @endDate)
	
	--Family Owed
	SELECT @p1FamilyOwed60 = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p1_feesOwed='$60' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2FamilyOwed60 = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p2_feesOwed='$60' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p1FamilyOwed120 = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p1_feesOwed='$120' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2FamilyOwed120 = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p2_feesOwed='$120' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p1familyOwedIndigent = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p1_feesOwed='Certificate of Indigency' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p2familyOwedIndigent = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND p2_feesOwed='Certificate of Indigency' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)

	SELECT @FamilyOwedWaived = COUNT(sessionid) from tjc_modules_med_fee_report_collected 
	WHERE sessionid IN (Select sessionid from tjc_modules_med_events where MediationHeld=1) AND FeeWaiver=1 AND CaseTypeGroupId=4 AND (p1_feesOwed IN ('$60','Certificate of Indigency','$120') OR p2_feesOwed IN ('$60','Certificate of Indigency','$120')) AND (MediationDate Between @startDate AND @endDate)

		
		--County Owed FTA
	SELECT @p1CountyOwedFTA60 = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p1_FTA=1 AND p1_feesOwed='$60' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2CountyOwedFTA60 = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p2_FTA=1 AND p2_feesOwed='$60' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p1CountyOwedIndigentFTA = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p1_FTA=1 AND p1_feesOwed='Certificate of Indigency' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p2CountyOwedIndigentFTA = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p2_FTA=1 AND p2_feesOwed='Certificate of Indigency' AND CaseTypeGroupId=2 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @CountyOwedWaivedFTA = COUNT(sessionid) from tjc_modules_med_fee_report_collected 
	WHERE (p1_FTA=1 OR p2_FTA=1) AND FeeWaiver=1 AND CaseTypeGroupId=2 AND (p1_feesOwed IN ('$60','Certificate of Indigency') OR p2_feesOwed IN ('$60','Certificate of Indigency')) AND (MediationDate Between @startDate AND @endDate)
	
	--Family Owed FTA
	SELECT @p1FamilyOwedFTA60 = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p1_FTA=1 AND p1_feesOwed='$60' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2FamilyOwedFTA60 = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p2_FTA=1 AND p2_feesOwed='$60' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p1FamilyOwedFTA120 = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p1_FTA=1 AND p1_feesOwed='$120' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)
	
	SELECT @p2FamilyOwedFTA120 = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p2_FTA=1 AND p2_feesOwed='$120' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p1familyOwedIndigentFTA = COUNT(p1_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p1_FTA=1 AND p1_feesOwed='Certificate of Indigency' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)

	SELECT @p2familyOwedIndigentFTA = COUNT(p2_feesOwed) from tjc_modules_med_fee_report_collected 
	WHERE p2_FTA=1 AND p2_feesOwed='Certificate of Indigency' AND CaseTypeGroupId=4 AND (MediationDate Between @startDate AND @endDate)

	SELECT @FamilyOwedWaivedFTA = COUNT(sessionid) from tjc_modules_med_fee_report_collected 
	WHERE (p2_FTA=1 or p1_FTA=1) AND feewaiver=1 AND CaseTypeGroupId=4 AND (p1_feesOwed IN ('$60','Certificate of Indigency','$120') OR p2_feesOwed IN ('$60','Certificate of Indigency','$120')) AND (MediationDate Between @startDate AND @endDate)


	--Results
	SELECT @mediationCounty AS 'CountyCount',@mediationFamily AS 'FamilyCount',
		(isnull(@p1CountyPaid60,0) + isnull(@p2CountyPaid60,0)) AS 'CountyPaid60',
		(isnull(@p1familyPaid60,0) + isnull(@p2familyPaid60,0)) AS 'FamilyPaid60',
		(isnull(@p1familyPaid120,0) + isnull(@p2familyPaid120,0)) AS 'FamilyPaid120',
		(isnull(@p1CountyOwed60,0) + isnull(@p2CountyOwed60,0)) AS 'CountyOwed',	
		(isnull(@p1FamilyOwed60,0) + isnull(@p2FamilyOwed60,0)) AS 'FamilyOwed60',
		(isnull(@p1FamilyOwed120,0) + isnull(@p2FamilyOwed120,0)) AS 'FamilyOwed120',
		(isnull(@p1FamilyOwedFTA60,0) + isnull(@p2FamilyOwedFTA60,0)) AS 'FamilyOwed60FTA',
		(isnull(@p1FamilyOwedFTA120,0) + isnull(@p2FamilyOwedFTA120,0)) AS 'FamilyOwed120FTA',
		(isnull(@p1CountyOwedFTA60,0) + isnull(@p2CountyOwedFTA60,0)) AS 'CountyOwedFTA',
		(isnull(@p1familyPaidIndigent,0) + isnull(@p2familyPaidIndigent,0)) AS 'FamilyPaidIndigent',
		(isnull(@p1CountyPaidIndigent,0) + isnull(@p2CountyPaidIndigent,0)) AS 'CountyPaidIndigent',
		(isnull(@p1familyOwedIndigent,0) + isnull(@p2familyOwedIndigent,0)) AS 'FamilyOwedIndigent',
		(isnull(@p1CountyOwedIndigent,0) + isnull(@p2CountyOwedIndigent,0)) AS 'CountyOwedIndigent',
		(isnull(@p1familyOwedIndigentFTA,0) + isnull(@p2familyOwedIndigentFTA,0)) AS 'FamilyOwedIndigentFTA',
		(isnull(@p1CountyOwedIndigentFTA,0) + isnull(@p2CountyOwedIndigentFTA,0)) AS 'CountyOwedIndigentFTA',
		@FamilyOwedWaived AS 'FamilyOwedWaived',@FamilyOwedWaivedFTA as 'FamilyOwedWaivedFTA',@FamilyPaidWaived as 'FamilyPaidWaived',
		@CountyOwedWaived as 'CountyOwedWaived',@CountyOwedWaivedFTA as 'CountyOwedWaivedFTA', @CountyPaidWaived as 'CountyPaidWaived'
		

		
END

	DECLARE issue_cursor CURSOR FOR 
	--Get CaseType list Juvenile Restitution

	SELECT DISTINCT i.Description as Issue
	FROM         tjc_modules_med_issue_by_group ic 
	INNER JOIN tjc_modules_med_groups g on ic.GroupId=g.GroupId 
	INNER JOIN tjc_modules_med_issues i on i.issueId = ic.issueId
	WHERE g.Description='Juvenile Restitution'

	OPEN issue_cursor

	FETCH NEXT FROM issue_cursor 
	INTO @issue
	WHILE @@FETCH_STATUS = 0
	BEGIN 
	--Populate regions by casetype
	INSERT INTO @RegionCounts
	Select region,issue, COUNT(SessionID) 
	from tjc_modules_med_session_issues_count 
	where MediationDate>=@startDate and MediationDate<=@endDate and CaseTypeGroup ='Juvenile Restitution' 
	and mediationheld=1 and issue=@issue
	Group By region,issue
	
	--Set Values
	SET @sarasota = (select  ISNULL(Sum(ISNULL(counts,0)),0) from @RegionCounts where Region like 'Sarasota%')
	SET @manatee = (select counts from @RegionCounts where region like 'Manatee')
	SET @desoto = (select counts from @RegionCounts where region like 'Desoto')
	SET @SouthCounty = (select counts from @RegionCounts where Region like 'Sarasota - South County')
	SET @NorthCounty =(select counts from @RegionCounts where Region like 'Sarasota - North County')
	
	--Insert Values
	INSERT INTO @tempData
	Select 'Juvenile Restitution','What percent of Juvenile Restitution mediations were ' + @issue + ' type cases?',
	ISNULL(@sarasota,0),ISNULL(@manatee,0),ISNULL(@desoto,0),ISNULL(@SouthCounty,0),ISNULL(@NorthCounty,0),
	ISNULL(@sarasota/NULLIF(@SarasotaTotalMediation,0),0),ISNULL(@manatee/NULLIF(@ManateeTotalMediation,0),0) ,
	ISNULL(@desoto/NULLIF(@DesotoTotalMediation,0),0)	
	
	--clear Variables
	Delete from @RegionCounts
	SET @sarasota = 0
	SET @manatee = 0
	SET @desoto = 0
	SET @SouthCounty = 0
	SET @NorthCounty = 0

	FETCH NEXT FROM issue_cursor 
	INTO @issue
	END

	CLOSE issue_cursor;
	DEALLOCATE issue_cursor;
	--End Percentage by Case Type
	
	--Clear Variables
	Delete from @RegionCounts
	SET @SarasotaTotalMediation = 0
	SET @ManateeTotalMediation = 0
	SET @DesotoTotalMediation = 0
	SET @sarasota = 0
	SET @manatee = 0
	SET @desoto = 0
	SET @SouthCounty = 0
	SET @NorthCounty = 0


<dotnetnuke type="Package" version="5.0">
	<packages>
		<package name="ProcessServer" type="Module" version="1.0.0">
			<friendlyName>Process Server Admin</friendlyName>
			<description>12th Judicial Circuit Certified Process Server application management - intranet (applications, payments, review, approve, reject and edit)</description>
			<iconFile>~/Icons/Sigma/Source_32X32_Standard.png</iconFile>
			<owner>
				<name>12th Judicial Circuit Court</name>
				<organization>12th Judicial Circuit Court</organization>
				<url>http://www.jud12.flcourts.org/</url>
				<email>jterhune@flcourts.org</email>
			</owner>
			<license src="License.txt"></license>
			<releaseNotes src="ReleaseNotes.txt"></releaseNotes>
			<components>
				<component type="Module">
					<desktopModule>
						<moduleName>Process Server Admin</moduleName>
						<foldername>tjc.Modules/ProcessServer</foldername>
						<businessControllerClass />
						<supportedFeatures />
						<moduleDefinitions>
							<moduleDefinition>
								<friendlyName>Process Server Admin</friendlyName>
								<definitionName>Process Server Admin</definitionName>
								<defaultCacheTime>0</defaultCacheTime>
								<moduleControls>
									<moduleControl>
										<controlKey />
										<controlSrc>DesktopModules/tjc.Modules/ProcessServer/List.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>Process Server Applications</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
										<viewOrder>0</viewOrder>
									</moduleControl>
									<moduleControl>
										<controlKey>edit</controlKey>
										<controlSrc>DesktopModules/tjc.Modules/ProcessServer/Edit.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>Edit Process Server Application</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
										<viewOrder>0</viewOrder>
									</moduleControl>
									<moduleControl>
										<controlKey>review</controlKey>
										<controlSrc>DesktopModules/tjc.Modules/ProcessServer/Review.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>Review Process Server Application</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
										<viewOrder>0</viewOrder>
									</moduleControl>
									<moduleControl>
										<controlKey>Settings</controlKey>
										<controlSrc>DesktopModules/tjc.Modules/ProcessServer/Settings.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>Process Server Admin Settings</controlTitle>
										<controlType>Edit</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
										<viewOrder>0</viewOrder>
									</moduleControl>
								</moduleControls>
							</moduleDefinition>
						</moduleDefinitions>
					</desktopModule>
				</component>
				<component type="Assembly">
					<assemblies>
						<assembly>
							<path>bin</path>
							<name>tjc.Modules.ProcessServer.dll</name>
						</assembly>
					</assemblies>
				</component>
				<component type="ResourceFile">
					<resourceFiles>
						<basePath>DesktopModules\tjc.Modules\ProcessServer</basePath>
						<resourceFile>
							<name>Resources.zip</name>
						</resourceFile>
					</resourceFiles>
				</component>
			</components>
		</package>
	</packages>
</dotnetnuke>

<dotnetnuke type="Package" version="5.0">
  <packages>
    <package name="PressCartAdmin" type="Module" version="00.00.01">
      <friendlyName>Press Cart Administration</friendlyName>
      <description>Intranet administration for the public site's presentation cart request form. Lists submitted requests, opens one in full, tracks a handling status with notes, deletes a request and exports to CSV, and manages the division, courtroom and courthouse lists the public form picks from. Reads and writes the public site's tjc_PressCart and tjc_presscart_* tables through the Jud12 connection.</description>
      <iconFile>~/Icons/Sigma/Monitor_32X32_Standard.png</iconFile>
      <owner>
        <name>12th Judicial Circuit</name>
        <organization>12th Judicial Circuit</organization>
        <url>https://www.jud12.flcourts.org/</url>
        <email>jterhune@jud12.flcourts.org</email>
      </owner>
      <license src="License.txt"></license>
      <releaseNotes src="ReleaseNotes.txt"></releaseNotes>
      <azureCompatible>true</azureCompatible>
      <dependencies>
        <dependency type="CoreVersion">09.08.00</dependency>
      </dependencies>
      <components>
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/tjc.modules/PressCart</basePath>
            <resourceFile>
              <name>Resources.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>
        <component type="Module">
          <desktopModule>
            <moduleName>PressCartAdmin</moduleName>
            <foldername>tjc.modules/PressCart</foldername>
            <businessControllerClass />
            <supportedFeatures />
            <moduleDefinitions>
              <moduleDefinition>
                <friendlyName>Press Cart Administration</friendlyName>
                <definitionName>PressCartAdmin</definitionName>
                <defaultCacheTime>0</defaultCacheTime>
                <moduleControls>
                  <moduleControl>
                    <controlKey />
                    <controlSrc>DesktopModules/tjc.modules/PressCart/Views/View.ascx</controlSrc>
                    <supportsPartialRendering>False</supportsPartialRendering>
                    <controlTitle>Presentation Cart Requests</controlTitle>
                    <controlType>View</controlType>
                    <iconFile />
                    <helpUrl />
                    <viewOrder>0</viewOrder>
                  </moduleControl>
                  <moduleControl>
                    <controlKey>ViewRequest</controlKey>
                    <controlSrc>DesktopModules/tjc.modules/PressCart/Views/ViewRequest.ascx</controlSrc>
                    <supportsPartialRendering>False</supportsPartialRendering>
                    <controlTitle>Presentation Cart Request</controlTitle>
                    <controlType>View</controlType>
                    <iconFile />
                    <helpUrl />
                    <viewOrder>0</viewOrder>
                  </moduleControl>
                  <moduleControl>
                    <controlKey>Division</controlKey>
                    <controlSrc>DesktopModules/tjc.modules/PressCart/Views/Division.ascx</controlSrc>
                    <supportsPartialRendering>False</supportsPartialRendering>
                    <controlTitle>Divisions</controlTitle>
                    <controlType>View</controlType>
                    <iconFile />
                    <helpUrl />
                    <viewOrder>0</viewOrder>
                  </moduleControl>
                  <moduleControl>
                    <controlKey>Courtroom</controlKey>
                    <controlSrc>DesktopModules/tjc.modules/PressCart/Views/Courtroom.ascx</controlSrc>
                    <supportsPartialRendering>False</supportsPartialRendering>
                    <controlTitle>Courtrooms</controlTitle>
                    <controlType>View</controlType>
                    <iconFile />
                    <helpUrl />
                    <viewOrder>0</viewOrder>
                  </moduleControl>
                  <moduleControl>
                    <controlKey>Courthouse</controlKey>
                    <controlSrc>DesktopModules/tjc.modules/PressCart/Views/Courthouse.ascx</controlSrc>
                    <supportsPartialRendering>False</supportsPartialRendering>
                    <controlTitle>Courthouses</controlTitle>
                    <controlType>View</controlType>
                    <iconFile />
                    <helpUrl />
                    <viewOrder>0</viewOrder>
                  </moduleControl>
                </moduleControls>
              </moduleDefinition>
            </moduleDefinitions>
          </desktopModule>
        </component>
        <component type="Assembly">
          <assemblies>
            <assembly>
              <name>tjc.Modules.PressCart.dll</name>
              <path>bin</path>
            </assembly>
          </assemblies>
        </component>
      </components>
    </package>
  </packages>
</dotnetnuke>

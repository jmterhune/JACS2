<Window x:Class="CourtCounsel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CourtCounsel.Desktop.ViewModels"
        Title="Court Counsel" Height="800" Width="1200" MinHeight="500" MinWidth="800">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#212529">
            <StackPanel Orientation="Horizontal" Margin="8">
                <Button Content="Search" Command="{Binding GoSearchCommand}" Style="{StaticResource NavButton}" />
                <Button Content="Data Entry" Command="{Binding GoDataEntryCommand}" Style="{StaticResource NavButton}" />
                <Button Content="Reports" Command="{Binding GoReportsCommand}" Style="{StaticResource NavButton}" />
                <Button Content="Data Sheet" Command="{Binding GoDataSheetCommand}" Style="{StaticResource NavButton}" />
                <Button Content="Update Case Name" Command="{Binding GoUpdateCaseNameCommand}" Style="{StaticResource NavButton}" />
                <Button Content="Admin" Command="{Binding GoAdminCommand}" Style="{StaticResource NavButton}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                <Button Content="Settings" Command="{Binding GoSettingsCommand}" Style="{StaticResource NavButton}"
                        Visibility="{Binding CanEditSettings, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
        <ContentControl Content="{Binding CurrentViewModel}" Margin="12" />
    </DockPanel>
</Window>

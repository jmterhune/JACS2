<UserControl x:Class="CourtCounsel.Desktop.Views.LookupTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CourtCounsel.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance vm:LookupTabViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <DockPanel Margin="8">
        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="10,4"
                Command="{Binding AddCommand}">
            <TextBlock>
                <Run Text="Add " /><Run Text="{Binding EntityLabel, Mode=OneWay}" />
            </TextBlock>
        </Button>

        <Border DockPanel.Dock="Top" Background="#f8f9fa" BorderBrush="#dee2e6" BorderThickness="1" Padding="12" Margin="0,0,0,8"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left" Padding="4" Margin="0,0,0,8" />
                <CheckBox Content="Is Active" IsChecked="{Binding EditIsActive}" Margin="0,0,0,8"
                          Visibility="{Binding SupportsActive, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Command="{Binding SaveCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Cancel" Command="{Binding CancelEditCommand}" Padding="12,4" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="80" />
                <DataGridTemplateColumn Header="" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Padding="8,2" Margin="0,0,4,0"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Delete" Padding="8,2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

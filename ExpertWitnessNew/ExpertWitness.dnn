<dotnetnuke type="Package" version="5.0">
  <packages>
    <package name="ExpertWitness" type="Module" version="00.00.03">
      <friendlyName>ExpertWitness</friendlyName>
      <description>Joe Terhune ExpertWitness module</description>
      <iconFile>~/Images/icon_extensions_32px.png</iconFile>
      <owner>
        <name>Joe Terhune</name>
        <organization>Joe Terhune</organization>
        <url>https://www.jud12.flcourts.org/</url>
        <email>jterhune@jud12.flcourts.org</email>
      </owner>
      <license src="License.txt"></license>
      <releaseNotes src="ReleaseNotes.txt"></releaseNotes>
      <azureCompatible>true</azureCompatible>
      <dependencies>
        <dependency type="CoreVersion">09.08.00</dependency>
      </dependencies>
      
      <components>
        <component type="Script">
          <scripts>
            <basePath>DesktopModules\tjc.Modules\ExpertWitness</basePath>
            <script type="Install">
              <path>Providers\DataProviders\SqlDataProvider</path>
              <name>00.00.01.SqlDataProvider</name>
              <version>00.00.01</version>
            </script>
            <script type="Install">
              <path>Providers\DataProviders\SqlDataProvider</path>
              <name>00.00.02.SqlDataProvider</name>
              <version>00.00.02</version>
            </script>
            <script type="UnInstall">
              <path>Providers\DataProviders\SqlDataProvider</path>
              <name>Uninstall.SqlDataProvider</name>
              <version>00.00.01</version>
            </script>
          </scripts>
        </component>

        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/tjc.Modules/ExpertWitness</basePath>
            <resourceFile>
              <name>Resources.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>

        <component type="Module">
			<desktopModule>
				<moduleName>Expert Witness</moduleName>
				<foldername>tjc.modules/ExpertWitness</foldername>
				<businessControllerClass />
				<supportedFeatures />
				<moduleDefinitions>
					<moduleDefinition>
						<friendlyName>Expert Witness</friendlyName>
						<definitionName>Expert Witness</definitionName>
						<defaultCacheTime>0</defaultCacheTime>
						<moduleControls>
							<moduleControl>
								<controlKey />
								<controlSrc>DesktopModules/tjc.modules/ExpertWitness/View.ascx</controlSrc>
								<supportsPartialRendering>False</supportsPartialRendering>
								<controlTitle />
								<controlType>View</controlType>
								<iconFile />
								<helpUrl />
								<supportsPopUps>False</supportsPopUps>
								<viewOrder>0</viewOrder>
							</moduleControl>
							<moduleControl>
								<controlKey>evaluation</controlKey>
								<controlSrc>DesktopModules/tjc.modules/ExpertWitness/admin/TemplateList.ascx</controlSrc>
								<supportsPartialRendering>False</supportsPartialRendering>
								<controlTitle>Evaluation List</controlTitle>
								<controlType>View</controlType>
								<iconFile />
								<helpUrl />
								<supportsPopUps>False</supportsPopUps>
								<viewOrder>0</viewOrder>
							</moduleControl>
							<moduleControl>
								<controlKey>expert</controlKey>
								<controlSrc>DesktopModules/tjc.modules/ExpertWitness/admin/ExpertList.ascx</controlSrc>
								<supportsPartialRendering>False</supportsPartialRendering>
								<controlTitle>Expert List</controlTitle>
								<controlType>View</controlType>
								<iconFile />
								<helpUrl />
								<supportsPopUps>False</supportsPopUps>
								<viewOrder>0</viewOrder>
							</moduleControl>
							<moduleControl>
								<controlKey>location</controlKey>
								<controlSrc>DesktopModules/tjc.modules/ExpertWitness/admin/LocationList.ascx</controlSrc>
								<supportsPartialRendering>False</supportsPartialRendering>
								<controlTitle>Location List</controlTitle>
								<controlType>View</controlType>
								<iconFile />
								<helpUrl />
								<supportsPopUps>False</supportsPopUps>
								<viewOrder>0</viewOrder>
							</moduleControl>
							<moduleControl>
								<controlKey>request</controlKey>
								<controlSrc>DesktopModules/tjc.modules/ExpertWitness/admin/RequestList.ascx</controlSrc>
								<supportsPartialRendering>False</supportsPartialRendering>
								<controlTitle>Request List</controlTitle>
								<controlType>View</controlType>
								<iconFile />
								<helpUrl />
								<supportsPopUps>False</supportsPopUps>
								<viewOrder>0</viewOrder>
							</moduleControl>
							<moduleControl>
								<controlKey>Settings</controlKey>
								<controlSrc>DesktopModules/tjc.modules/ExpertWitness/Settings.ascx</controlSrc>
								<supportsPartialRendering>False</supportsPartialRendering>
								<controlTitle>Expert Witness Settings</controlTitle>
								<controlType>Edit</controlType>
								<iconFile />
								<helpUrl />
								<supportsPopUps>False</supportsPopUps>
							</moduleControl>
							<moduleControl>
								<controlKey>type</controlKey>
								<controlSrc>DesktopModules/tjc.modules/ExpertWitness/admin/TypeList.ascx</controlSrc>
								<supportsPartialRendering>False</supportsPartialRendering>
								<controlTitle>Expert Type List</controlTitle>
								<controlType>View</controlType>
								<iconFile />
								<helpUrl />
								<supportsPopUps>False</supportsPopUps>
								<viewOrder>0</viewOrder>
							</moduleControl>
						</moduleControls>
					</moduleDefinition>
				</moduleDefinitions>
			</desktopModule>
			<eventMessage>
            <processorType>DotNetNuke.Entities.Modules.EventMessageProcessor, DotNetNuke</processorType>
            <processorCommand>UpgradeModule</processorCommand>
            <attributes>
              <businessControllerClass>tjc.Modules.ExpertWitness.Components.FeatureController, ExpertWitness</businessControllerClass>
              <desktopModuleID>[DESKTOPMODULEID]</desktopModuleID>
              <upgradeVersionsList>00.00.01,00.00.02,00.00.03</upgradeVersionsList>
            </attributes>
          </eventMessage>
        </component>
        <component type="Assembly">
          <assemblies>
            <assembly>
              <name>tjc.Modules.ExpertWitness.dll</name>
              <path>bin</path>
            </assembly>
          </assemblies>
        </component>
      </components>
    </package>
  </packages>
</dotnetnuke>
<dotnetnuke type="Package" version="5.0">
	<packages>
		<package name="Employee Reports" type="Module" version="1.0.1">
			<friendlyName>Employee Reports</friendlyName>
			<description />
			<iconFile>/Images/icon_extensions_32px.png</iconFile>
			<owner>
				<name>Twelfth Judicial Circuit</name>
				<organization>Twelfth Judicial Circuit</organization>
				<url>https://www.jud12.flcourts.org</url>
				<email>jterhune@jud12.flcourts.org</email>
			</owner>
			<license>The license for this package is not currently included within the installation file, please check with the vendor for full license details.</license>
			<releaseNotes />
			<components>
				<component type="ResourceFile">
					<resourceFiles>
						<basePath>DesktopModules/tjc.modules/EmployeeReports</basePath>
						<resourceFile>
							<name>Resources.zip</name>
						</resourceFile>
					</resourceFiles>
				</component>
				<component type="Module">
					<desktopModule>
						<moduleName>Employee Reports</moduleName>
						<foldername>tjc.modules/EmployeeReports</foldername>
						<businessControllerClass>tjc.Modules.Reports.Components.FeatureController, tjc.Modules.Reports</businessControllerClass>
						<supportedFeatures >
							<supportedFeature>ISearchable</supportedFeature>
						</supportedFeatures>
						<moduleDefinitions>
							<moduleDefinition>
								<friendlyName>Employee Reports</friendlyName>
								<definitionName>Employee Reports</definitionName>
								<defaultCacheTime>0</defaultCacheTime>
								<moduleControls>
									<moduleControl>
										<controlKey />
										<controlSrc>DesktopModules/tjc.modules/EmployeeReports/View.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle />
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
										<viewOrder>0</viewOrder>
									</moduleControl>
									<moduleControl>
										<controlKey>DataCard</controlKey>
										<controlSrc>DesktopModules/tjc.modules/EmployeeReports/DataCardView.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>Data Card Report</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
									</moduleControl>
									<!-- Employee Reports — replaces HR's
									     DROP Participants.xlsx +
									     JA seniority.xlsx (4 sheets).
									     Each report is a separate
									     <moduleControl> with its own
									     controlKey so the URLs survive
									     DNN's URL-rewrite roundtrips. -->
									<moduleControl>
										<controlKey>DropParticipants</controlKey>
										<controlSrc>DesktopModules/tjc.modules/EmployeeReports/EmployeeReports/DropParticipantsReport.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>DROP Participants</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
									</moduleControl>
									<moduleControl>
										<controlKey>JaSeniority</controlKey>
										<controlSrc>DesktopModules/tjc.modules/EmployeeReports/EmployeeReports/JaSeniorityReport.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>JA Seniority</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
									</moduleControl>
									<moduleControl>
										<controlKey>StaffAttorneySeniority</controlKey>
										<controlSrc>DesktopModules/tjc.modules/EmployeeReports/EmployeeReports/StaffAttorneySeniorityReport.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>Staff Attorney Seniority</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
									</moduleControl>
									<moduleControl>
										<controlKey>CertifiedInterpreter</controlKey>
										<controlSrc>DesktopModules/tjc.modules/EmployeeReports/EmployeeReports/CertifiedInterpreterReport.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>Certified Interpreter Seniority</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
									</moduleControl>
								</moduleControls>
							</moduleDefinition>
							<moduleDefinition>
								<friendlyName>JACS Reports</friendlyName>
								<definitionName>JACS Reports</definitionName>
								<defaultCacheTime>0</defaultCacheTime>
								<moduleControls>
									<moduleControl>
										<controlKey />
										<controlSrc>DesktopModules/tjc.modules/EmployeeReports/WeekDayHearings.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>Week Day Hearing Report</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
									</moduleControl>
								</moduleControls>
							</moduleDefinition>
						</moduleDefinitions>
					</desktopModule>
					<eventMessage>
						<processorType>DotNetNuke.Entities.Modules.EventMessageProcessor, DotNetNuke</processorType>
						<processorCommand>UpgradeModule</processorCommand>
						<attributes>
							<businessControllerClass>tjc.Modules.Reports.Components.FeatureController, tjc.Modules.Reports</businessControllerClass>
							<desktopModuleID>[DESKTOPMODULEID]</desktopModuleID>
							<upgradeVersionsList>00.00.01,00.00.02</upgradeVersionsList>
						</attributes>
					</eventMessage>
				</component>
				<component type="Assembly">
					<assemblies>
						<assembly>
							<name>tjc.Modules.Reports.dll</name>
							<path>bin</path>
						</assembly>
					</assemblies>
				</component>
			</components>
		</package>
	</packages>
</dotnetnuke>
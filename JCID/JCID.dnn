<dotnetnuke type="Package" version="5.0">
	<packages>
		<package name="JCID.Admin" type="Module" version="1.0.0">
			<friendlyName>JCID Admin</friendlyName>
			<description>12th Judicial Circuit Judicial Center Identification (JCID) application management - intranet (application list, credit-card payments, review, edit, reject)</description>
			<iconFile>~/Icons/Sigma/Source_32X32_Standard.png</iconFile>
			<owner>
				<name>12th Judicial Circuit Court</name>
				<organization>12th Judicial Circuit Court</organization>
				<url>http://www.jud12.flcourts.org/</url>
				<email>jterhune@flcourts.org</email>
			</owner>
			<license src="License.txt"></license>
			<releaseNotes src="ReleaseNotes.txt"></releaseNotes>
			<components>
				<component type="Module">
					<desktopModule>
						<moduleName>JCID Admin</moduleName>
						<foldername>tjc.Modules/JCID</foldername>
						<businessControllerClass />
						<supportedFeatures />
						<moduleDefinitions>
							<moduleDefinition>
								<friendlyName>JCID Admin</friendlyName>
								<definitionName>JCID Admin</definitionName>
								<defaultCacheTime>0</defaultCacheTime>
								<moduleControls>
									<moduleControl>
										<controlKey />
										<controlSrc>DesktopModules/tjc.Modules/JCID/TransactionList.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>JCID Applications</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
										<viewOrder>0</viewOrder>
									</moduleControl>
									<moduleControl>
										<controlKey>edit</controlKey>
										<controlSrc>DesktopModules/tjc.Modules/JCID/Edit.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>Edit JCID Application</controlTitle>
										<controlType>View</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
										<viewOrder>0</viewOrder>
									</moduleControl>
									<moduleControl>
										<controlKey>Settings</controlKey>
										<controlSrc>DesktopModules/tjc.Modules/JCID/Settings.ascx</controlSrc>
										<supportsPartialRendering>False</supportsPartialRendering>
										<controlTitle>JCID Admin Settings</controlTitle>
										<controlType>Edit</controlType>
										<iconFile />
										<helpUrl />
										<supportsPopUps>False</supportsPopUps>
										<viewOrder>0</viewOrder>
									</moduleControl>
								</moduleControls>
							</moduleDefinition>
						</moduleDefinitions>
					</desktopModule>
				</component>
				<component type="Assembly">
					<assemblies>
						<assembly>
							<path>bin</path>
							<name>tjc.Modules.JCID.dll</name>
						</assembly>
					</assemblies>
				</component>
				<component type="ResourceFile">
					<resourceFiles>
						<basePath>DesktopModules\tjc.Modules\JCID</basePath>
						<resourceFile>
							<name>Resources.zip</name>
						</resourceFile>
					</resourceFiles>
				</component>
			</components>
		</package>
	</packages>
</dotnetnuke>
